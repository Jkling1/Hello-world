# Copy to .env — never commit the real file.

# Anthropic API key for the live AI coach. Leave empty to run with the
# built-in deterministic mock coach (everything still works, keyless).
ANTHROPIC_API_KEY=

# Server port (web dev server proxies /api here)
PORT=3001

# SQLite database location (default: ./data/vantage.db)
VANTAGE_DB_PATH=
